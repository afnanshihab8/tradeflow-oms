# These values are for a local Docker environment only. Change them for any shared deployment.
TF_DJANGO_SECRET_KEY=local-docker-secret-change-before-deployment
TF_POSTGRES_DB=tradeflow_oms
TF_POSTGRES_USER=tradeflow
TF_POSTGRES_PASSWORD=tradeflow-local-password
TF_WEB_PORT=8000

# The seed command is idempotent and makes the reviewer environment ready to use.
TF_SEED_DEMO=true
TF_DEMO_ADMIN_PASSWORD=LocalAdmin!2026
TF_DEMO_CUSTOMER_PASSWORD=LocalCustomer!2026
